{
  "name": "obsidian-webview-text-selector",
  "version": "1.1.0",
  "description": "Plugin do Obsidian que transforma textos copiados do Web viewer em citações formatadas.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "webviewer",
    "citation",
    "clipboard"
  ],
  "author": "Juan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.12",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3"
  }
}
